{
  "name": "financialmanager",
  "version": "0.1.0",
  "private": true,
  "description": "Finanzas personales locales — React + Electron",
  "author": "Santiago",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "smoke:db": "node scripts/smoke-db.mjs",
    "smoke:pending": "node scripts/smoke-pending-payments.mjs",
    "smoke:history": "node scripts/smoke-history.mjs",
    "smoke:etapa8": "npx --yes vite-node scripts/smoke-etapa-8.ts",
    "smoke:settings": "npx --yes vite-node scripts/smoke-settings.ts",
    "smoke": "npm run smoke:db && npm run smoke:pending && npm run smoke:history && npm run smoke:etapa8 && npm run smoke:settings",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "better-sqlite3": "^13.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^37.2.0",
    "electron-vite": "^4.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^6.3.5"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "esbuild@0.25.12": true,
    "better-sqlite3@13.2.0": true
  }
}
